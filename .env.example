# ─────────────────────────────────────────────────────────────────────────────
# APIHunter Security Intelligence Platform — Environment Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
Database__ConnectionString=Host=localhost;Port=5432;Database=platform_db;Username=platform;Password=changeme

# Data Protection (leave empty for dev ephemeral keys)
DataProtection__KeyPath=
DataProtection__ApplicationName=APIHunterPlatform

# Seed Admin (used only on first startup if no admin exists)
Seed__AdminEmail=admin@yourdomain.com
Seed__AdminPassword=ChangeThisOnFirstRun!

# CORS (comma-separated allowed frontend origins)
Cors__AllowedOrigins__0=http://localhost:3000

# Authentication
Authentication__SessionDurationMinutes=480
Authentication__LockoutThreshold=5
Authentication__LockoutDurationMinutes=15

# Rate Limiting
RateLimiting__LoginMaxAttempts=5
RateLimiting__LoginWindowSeconds=300

# Email provider selection: smtp | sendgrid | mailgun
Notification__EmailProvider=smtp

# ── SMTP ──
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__From=
Smtp__UseTls=true

# ── SendGrid ──
SendGrid__ApiKey=
SendGrid__From=

# ── Mailgun ──
Mailgun__ApiKey=
Mailgun__Domain=
Mailgun__Region=us
Mailgun__From=
