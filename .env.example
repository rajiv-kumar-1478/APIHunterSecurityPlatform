# APIHunter Security Intelligence Platform
# Copy to .env for local Compose use and replace every example secret.
# Never commit the resulting .env file.

# Required single-tenant deployment boundary (use a stable UUID per deployment)
TENANT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
Tenant__Id=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa

# Compose database settings (PostgreSQL is private to the backend network)
POSTGRES_DB=platform_db
POSTGRES_USER=platform
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public origins compiled/configured for the browser deployment
FRONTEND_ORIGIN=https://security.example.com
NEXT_PUBLIC_API_URL=https://api.security.example.com
API_PORT=5000
FRONTEND_PORT=3000

# Initial administrator (first startup only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Production Master Encryption Key (minimum 32 characters / 256 bits for AES-256)
MASTER_ENCRYPTION_KEY=replace-with-a-random-at-least-32-char-key-for-prod
Security__MasterEncryptionKey=replace-with-a-random-at-least-32-char-key-for-prod

# Direct-host configuration equivalents
Database__ConnectionString=Host=localhost;Port=5432;Database=platform_db;Username=platform;Password=replace-with-a-long-random-password

# External APIHunter scraper database. The VPS SSH tunnel overrides Host/Port at runtime.
ApiHunterSource__ConnectionString=Host=127.0.0.1;Port=5432;Database=unsecuredapikeys_db;Username=postgres;Password=replace-with-the-db-password;SSL Mode=Disable

# VPS SSH: used for the APIHunter DB tunnel and for git clone/archive downloads.
# Mount the private key into the container and point PrivateKeyPath at the mounted path.
VpsSsh__Enabled=false
VpsSsh__Host=
VpsSsh__Port=22
VpsSsh__Username=ubuntu
VpsSsh__PrivateKeyPath=
VpsSsh__PrivateKeyPassphrase=
VpsSsh__MaxArchiveBytes=536870912
VpsSsh__HostKeyFingerprint=
VpsSsh__RemoteWorkDir=/tmp/apihunter-repos
VpsSsh__GitBinaryPath=git
VpsSsh__ConnectTimeoutSeconds=30
VpsSsh__CommandTimeoutSeconds=300
DataProtection__KeyPath=
DataProtection__ApplicationName=APIHunterPlatform
Authentication__RequireHttps=true
Cors__AllowedOrigins__0=https://security.example.com

# Scanner execution is intentionally fail-closed until a verified executor,
# forwarding egress boundary, and authoritative tool/provider contracts exist.
ScannerRuntime__RuntimeMode=Disabled
ScannerRuntime__EgressGatewayMode=None
ScannerRuntime__EgressNetworkName=
ScannerRuntime__EgressGatewayEndpoint=
ScannerRuntime__AllowUnsafeProcessFallback=false
ScanJobConsumer__Enabled=false
CampaignScheduler__GlobalEnabled=false

# Authentication and rate limiting
Authentication__SessionDurationMinutes=480
Authentication__LockoutThreshold=5
Authentication__LockoutDurationMinutes=15
RateLimiting__LoginMaxAttempts=5
RateLimiting__LoginWindowSeconds=300

# Email provider: smtp | sendgrid | mailgun
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SENDGRID_API_KEY=
SENDGRID_FROM=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAILGUN_FROM=

# AI provider keys for the full-repository secret audit (at least one required).
# The router prefers DeepSeek, then Groq, then OpenAI/Anthropic/Cohere.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# AI investigation limits (full-content audit)
AiInvestigation__MaxFilesPerInvestigation=250
AiInvestigation__MaxAiCallsPerInvestigation=30
AiInvestigation__MaxTokensPerInvestigation=400000
AiInvestigation__MaxAiFilesPerCall=12
AiInvestigation__MaxAiInputCharactersPerCall=48000
