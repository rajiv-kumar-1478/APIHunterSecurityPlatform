{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Tenant": {
    "Id": "11111111-1111-1111-1111-111111111111"
  },
  "DataProtection": {
    "KeyPath": "",
    "ApplicationName": "APIHunterPlatform"
  },
  "CampaignScheduler": {
    "GlobalEnabled": false,
    "TickIntervalSeconds": 30,
    "MaxCampaignsPerTick": 50,
    "StuckJobThresholdMinutes": 60,
    "RecoveryIntervalSeconds": 300,
    "HeartbeatIntervalSeconds": 120
  },
  "ScanJobConsumer": {
    "Enabled": false,
    "PollIntervalSeconds": 3,
    "ClaimContentionRetries": 5
  },
  "ScannerRuntime": {
    "RuntimeMode": "Disabled",
    "EgressGatewayMode": "None",
    "EgressNetworkName": "",
    "EgressGatewayEndpoint": "",
    "HostedScannerServiceEndpoint": "",
    "HostedScannerServiceKey": "",
    "MaxCpuCores": 2.0,
    "MaxMemoryBytes": 1073741824,
    "MaxPids": 100,
    "MaxScratchDiskBytes": 524288000,
    "ExecutionTimeout": "00:10:00",
    "EnableReadOnlyRoot": true,
    "DropAllCapabilities": true,
    "NoNewPrivileges": true,
    "RequireDockerSandbox": false,
    "EnforceImageProvenance": true,
    "AllowUnsafeProcessFallback": false,
    "TrustedImageRegistries": [
      "ghcr.io/apihunter-security",
      "docker.io/apihunter",
      "quay.io/apihunter"
    ]
  }
}
