{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Database": {
    "ConnectionString": ""
  },
  "DataProtection": {
    "KeyPath": "",
    "ApplicationName": "APIHunterPlatform"
  },
  "Authentication": {
    "SessionDurationMinutes": 480,
    "LockoutThreshold": 5,
    "LockoutDurationMinutes": 15,
    "MaxConcurrentSessions": 10,
    "RequireHttps": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "LoginMaxAttempts": 5,
    "LoginWindowSeconds": 300,
    "ApiMaxRequestsPerMinute": 300
  },
  "Notification": {
    "EmailProvider": "smtp"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "",
    "UseTls": true
  },
  "SendGrid": {
    "ApiKey": "",
    "From": ""
  },
  "Mailgun": {
    "ApiKey": "",
    "Domain": "",
    "Region": "us",
    "From": ""
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": ""
  },
  "AllowedHosts": "*"
}
